# Copy to /etc/systemd/system/safefilehub.service after setting binary/user/group/paths.
# data contains SQLite (WAL files), objects, staging, and archive artifacts; keep all on one persistent filesystem.
[Unit]
Description=SafeFileHub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=safefilehub
Group=safefilehub
WorkingDirectory=/var/lib/safefilehub
# stderr stays available to journald. --log-path mirrors application logs to a private rotating file.
ExecStart=/usr/local/bin/safefilehub --recover-on-start=true --log-format=json --log-path=/var/log/safefilehub/app.json --log-max-bytes=104857600 --log-retention-days=30 --log-backups=10 --trusted-proxy-cidr=127.0.0.1/32 --trusted-proxy-cidr=::1/128
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/safefilehub/data /var/log/safefilehub
LimitNOFILE=65536
UMask=0077
# Create /var/lib/safefilehub/data as safefilehub:safefilehub mode 0700.
# Create /var/log/safefilehub as root:safefilehub mode 0770 before starting.
# Change/remove trusted-proxy CIDRs if the service is not directly behind those proxies.
# Never place passwords or session material in this unit.

[Install]
WantedBy=multi-user.target
