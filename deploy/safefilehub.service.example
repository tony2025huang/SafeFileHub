# Copy to /etc/systemd/system/safefilehub.service after setting paths/user.
# data contains SQLite, objects, staging, and archive artifacts; keep it on one filesystem for atomic publication.
[Unit]
Description=SafeFileHub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=safefilehub
Group=safefilehub
WorkingDirectory=/var/lib/safefilehub
ExecStart=/usr/local/bin/safefilehub -recover-on-start=true
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/safefilehub/data
LimitNOFILE=65536
UMask=0077
# Supply application configuration using the approved deployment mechanism;
# never place passwords or session material in this unit.

[Install]
WantedBy=multi-user.target

# Logging/reverse proxy example (append flags to ExecStart as appropriate):
# --log-path=/var/log/safefilehub/app.json --log-format=json --log-retention-days=30 \
# --trusted-proxy-cidr=127.0.0.1/32 --trusted-proxy-cidr=::1/128
# Keep WorkingDirectory/data on persistent disk; do not use tmpfs for production data.
